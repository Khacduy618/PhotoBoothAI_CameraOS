{
  "name": "photoboothai_cameraos",
  "version": "0.1.0",
  "private": true,
  "main": "apps/desktop/electron/main/main.cjs",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:web": "next dev --webpack",
    "dev:desktop": "concurrently -k \"vite --config apps/desktop/renderer/vite.config.mts\" \"wait-on http://127.0.0.1:5173 && electron apps/desktop/electron/main/main.cjs\"",
    "dev:desktop:debug": "concurrently -k \"vite --config apps/desktop/renderer/vite.config.mts\" \"wait-on http://127.0.0.1:5173 && electron --remote-debugging-port=9223 apps/desktop/electron/main/main.cjs\"",
    "test:desktop:e2e": "playwright test -c apps/desktop/playwright.electron.config.ts",
    "build": "next build --webpack",
    "build:web": "next build --webpack",
    "build:desktop": "vite build --config apps/desktop/renderer/vite.config.mts",
    "package:desktop": "pnpm build:desktop && electron-builder",
    "package:desktop:win": "pnpm build:desktop && electron-builder --win",
    "start": "next start",
    "lint": "eslint app apps components hooks packages services types utils --quiet",
    "test": "vitest run",
    "rebuild:sqlite": "scripts\\rebuild-sqlite-win64.bat",
    "typecheck": "tsc --noEmit",
    "ci:repo": "node scripts/ci/check-repo-clean.mjs",
    "ci:architecture": "node scripts/ci/check-architecture.mjs",
    "verify": "pnpm ci:repo && pnpm ci:architecture && pnpm typecheck && pnpm lint && pnpm test && pnpm build:web && pnpm build:desktop"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "better-sqlite3": "^13.0.2",
    "lucide-react": "^1.31.0",
    "motion": "^13.1.0",
    "next": "16.2.10",
    "onnxruntime-web": "^1.27.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "electron": "^43.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  }
}
